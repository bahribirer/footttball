# ==============================================================================
# Tiki Taka Toe — Çevre Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosya repoda şablon olarak durur. Yerel geliştirme için:
#   cp .env.example .env
# komutunu çalıştırarak kendi .env dosyanızı oluşturabilirsiniz.
# Gerçek .env dosyası asla Git'e commit edilmemelidir.
# ==============================================================================

# --- Uygulama Modu ---
ENVIRONMENT=development
DEBUG=true

# --- Veritabanı ve Medya Yolları ---
# NOT: tikitakapi.db (~33 MB) depoda tutulmaz. Proje sahibinden alıp
# backend/data/ dizini altına koymanız gerekir.
DB_PATH=./backend/data/tikitakapi.db
LOGO_DIR=./backend/static/logos

# --- İsteğe Bağlı: Çok Süreçli Çalışma ve Redis ---
# Boş bırakılırsa tek süreç + yerel disk anlık görüntüsü (snapshot) kullanılır.
# Redis ile test etmek için yorumu kaldırın:
# REDIS_URL=redis://localhost:6379/0

# --- İsteğe Bağlı: Hata Takibi (Sentry) ---
# Boş bırakılırsa hata takibi sessizce kapalı kalır.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Acil Mod Kapatma ---
# Virgülle ayrılmış mod kimlikleri (örn: "last_letter,category_race")
# MODES_DISABLED=

# --- Docker Compose Port ve İmaj Ayarları ---
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=8000
BACKEND_IMAGE=footttball-backend:latest
BACKEND_DATA_DIR=./backend/data

