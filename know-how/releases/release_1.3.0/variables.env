# Sürüm değişkenleri — --init bunu release klasörüne kopyalar, sen doldurursun.
#
# TARGET: templates/targets.env'deki hedef adı. Mimari ve kurulum dizini
# oradan gelir; burada yol yazılmaz.
TARGET=production

# Servis kaynakları. Her satır bir servisin nereden geleceğini söyler:
#
#   build:<dizin>          çalışma ağacındaki dizinden derle
#   build:<dizin>@<ref>    o git referansındaki (commit/etiket/dal) hâlinden derle
#   image:<ad:etiket>      hazır imajı çek (üçüncü parti için)
#   skip                   bu sürümde pakete girmez, önceki etiket devralınır
#
# --init değişmeyen servisleri "skip" ile önceden doldurur; istersen ez.
BACKEND_SOURCE=skip
REDIS_SOURCE=skip
NGINX_SOURCE=skip
CERTBOT_SOURCE=skip

# Oyuncu veritabanı pakete girsin mi (ilk kurulumda 1, güncellemede 0)
WITH_DATA=0
