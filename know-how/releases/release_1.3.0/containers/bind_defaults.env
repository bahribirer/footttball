# Bind bağlamaları ve portlar. update.sh bunları hedefteki .env'e
# yazar; zaten tanımlıysa dokunmaz, böylece taşınmış bir dizin
# sonraki güncellemede geri alınmaz.

BACKEND_DATA_DIR=./backend/data
HTTPS_PORT=443
HTTP_PORT=80
INFRA_CERTBOT_CONF_DIR=./infra/certbot/conf
INFRA_CERTBOT_WWW_DIR=./infra/certbot/www
INFRA_NGINX_CONFD_DIR=./infra/nginx/conf.d
INFRA_NGINX_CONF_FILE=./infra/nginx/nginx.conf
