RELEASE_VERSION=1.2.0
BACKEND_IMAGE=footttball-backend:1.2.0
NGINX_IMAGE=ttt-nginx:1.2.0
REDIS_IMAGE=ttt-redis:1.2.0
CERTBOT_IMAGE=ttt-certbot:1.2.0
