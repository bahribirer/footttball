# Hedef makine kataloğu.
#
# variables.env'deki TARGET buradan çözülür: hangi mimari, hangi kurulum
# dizini. Hedefe özgü bilgi yalnızca burada durur — paket üretirken elle
# yazılmaz, yazılsa iki yerde çelişebilirdi.
#
# Yeni hedef eklemek: üç satır kopyala, adı değiştir.

# Üretim sunucusu (AWS EC2, x86)
production_PLATFORM=linux/amd64
production_DEPLOY_DIR=/srv/tikitakatoe
production_DESCRIPTION=Üretim sunucusu

# Yerel deneme (Apple Silicon Mac'te paketi kendi makinende uygulamak için)
local_PLATFORM=linux/arm64
local_DEPLOY_DIR=/tmp/ttt-target
local_DESCRIPTION=Yerel simülasyon
